# Vi3ion configuration. Copy to .env and edit. Never commit .env.

# Local development server (bind loopback only)
VI3ION_HOST=127.0.0.1
VI3ION_PORT=8765

# Storage
VI3ION_DATA_DIR=./data

# Image limits
VI3ION_MAX_IMAGE_BYTES=41943040
VI3ION_MAX_IMAGE_PIXELS=80000000
VI3ION_ANALYSIS_MAX_DIM=2048
VI3ION_THUMBNAIL_MAX_DIM=480

# Filesystem access for agent-supplied image paths.
# Semicolon-separated absolute directories. Paths outside these roots are refused.
# Defaults to the current working directory + data dir when unset.
# VI3ION_ALLOWED_ROOTS=C:\Users\you\projects;D:\screenshots

# OCR
VI3ION_OCR_ENABLED=true
VI3ION_OCR_MIN_CONFIDENCE=0.35

# Semantic vision is opt-in and runs locally. Values: none | mock | remote |
# florence | owlvit | clip, comma-separated for several providers.
#   mock      - deterministic fixture results (tests, offline dev)
#   remote    - OpenAI-compatible API (image leaves the machine: opt-in)
#   florence  - Florence-2 base, local object detection + region captions
#   owlvit    - OWL-ViT open-vocabulary detector (vocabulary JSON, extendable)
#   clip      - CLIP zero-shot scene tags (top 3, suggested)
VI3ION_SEMANTIC_PROVIDER=none
VI3ION_SEMANTIC_BASE_URL=https://api.openai.com/v1
VI3ION_SEMANTIC_MODEL=
VI3ION_SEMANTIC_API_KEY=
# Local model ids (change to use other checkpoints)
# VI3ION_SEMANTIC_FLORENCE_MODEL=microsoft/Florence-2-base
# VI3ION_SEMANTIC_OWLVIT_MODEL=google/owlv2-base-patch16
# VI3ION_SEMANTIC_CLIP_MODEL=openai/clip-vit-base-patch32
# OWL-ViT minimum detection confidence and custom vocabulary file
# VI3ION_SEMANTIC_MIN_CONFIDENCE=0.35
# VI3ION_SEMANTIC_VOCAB_PATH=D:\path\to\vocabulary.json
# Mock provider results file (JSON keyed by image sha256)
# VI3ION_SEMANTIC_MOCK_PATH=D:\path\to\mock_results.json
